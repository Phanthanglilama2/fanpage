PORT=3000
HOST=0.0.0.0

# Token tu Meta Developers > Messenger > Settings.
PAGE_ACCESS_TOKEN=your_page_access_token

# Chuoi bat ky do ban tu dat, sau do nhap vao Meta khi cau hinh Webhook.
VERIFY_TOKEN=your_verify_token

# Nen dung version dang hien thi trong Meta App Dashboard cua ban.
GRAPH_API_VERSION=v24.0

# Khuyen nghi bat khi len production de xac thuc request tu Meta.
APP_SECRET=your_meta_app_secret

# Tuy chon: bao ve endpoint xem leads /leads.
ADMIN_TOKEN=change_me

# Khuyen nghi khi deploy Vercel: ket noi Upstash Redis/KV tren Vercel Marketplace.
# Vercel/Upstash se tu tao cac bien nay sau khi ban connect storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Co the dung ten bien Upstash truc tiep neu dashboard cua ban hien thi cap nay.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tuy chon: doi key luu danh sach lead trong Redis/KV.
LEADS_STORAGE_KEY=fanpage-driving-school-leads

# Tuy chon: doi key luu trang thai hoi thoai trong Redis/KV.
SESSIONS_STORAGE_KEY=fanpage-driving-school-sessions
